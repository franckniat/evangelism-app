# =============================================================
#  Moisson — modèle de configuration
#  Copiez ce fichier vers `.env` et renseignez vos propres valeurs.
#  Les valeurs se trouvent dans Supabase → Project Settings → API.
# =============================================================

# --- Client Supabase (embarqué dans le bundle de l'app) -------
# Publiques par nature : la sécurité repose sur les politiques RLS.
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon

# --- Admin / CLI uniquement -----------------------------------
# NE JAMAIS préfixer ces variables par EXPO_PUBLIC_ ou NEXT_PUBLIC_ :
# elles seraient embarquées en clair dans l'application et
# donneraient un accès administrateur complet à la base de données.
SUPABASE_PROJECT_REF=votre_project_ref
SUPABASE_PUBLISHABLE_KEY=votre_cle_publishable
SUPABASE_SECRET_KEY=votre_cle_secrete
SUPABASE_DB_PASSWORD=votre_mot_de_passe_base
