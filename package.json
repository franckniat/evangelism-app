{
  "name": "moisson",
  "private": true,
  "version": "1.0.0",
  "description": "Moisson — application collaborative de suivi d'évangélisation (mobile, web, desktop)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "mobile": "bun run --filter @moisson/mobile dev",
    "web": "bun run --filter @moisson/web dev",
    "backend": "bun run --filter @moisson/backend dev"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
