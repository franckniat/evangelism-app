{
  "name": "harvest",
  "private": true,
  "version": "1.0.0",
  "description": "Harvest — application collaborative de suivi d'évangélisation (mobile, web, desktop)",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "mobile": "bun run --filter @harvest/mobile dev",
    "web": "bun run --filter @harvest/web dev",
    "backend": "bun run --filter @harvest/backend dev",
    "desktop": "bun run --filter @harvest/desktop dev"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "trustedDependencies": [
    "argon2"
  ],
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
