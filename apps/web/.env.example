#--------------------------------------------------------------------
# Adresse de l'API
#--------------------------------------------------------------------
# Volontairement SANS le préfixe `NEXT_PUBLIC_` : le navigateur n'a pas à
# connaître cette adresse, et surtout pas à l'appeler lui-même. Toutes les
# requêtes partent du serveur Next, avec le jeton lu dans un cookie
# `httpOnly` que le script de la page ne peut pas voir.
API_URL=http://localhost:3333/api/v1
