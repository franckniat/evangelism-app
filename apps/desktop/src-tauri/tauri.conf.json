{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Harvest",
  "version": "1.0.0",
  "identifier": "org.harvest.app",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run --filter @harvest/web dev",
    "beforeBuildCommand": "bun run --filter @harvest/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Harvest",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
