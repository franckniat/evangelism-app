#--------------------------------------------------------------------
# Adresse de l'API
#--------------------------------------------------------------------
# ⚠️ Les variables EXPO_PUBLIC_* sont inscrites EN CLAIR dans le bundle
# livré. Une URL publique n'est pas un secret, mais aucune clé, aucun
# jeton et aucun mot de passe ne doit jamais passer par ce préfixe.
#
# Selon d'où l'application tourne :
#   • simulateur iOS / Expo Go sur la machine  → http://localhost:3333/api/v1
#   • émulateur Android                        → http://10.0.2.2:3333/api/v1
#     (« localhost » y désigne l'émulateur, pas la machine hôte)
#   • téléphone physique sur le même Wi-Fi     → http://192.168.x.x:3333/api/v1
#     et démarrer le serveur avec HOST=0.0.0.0, sinon il n'écoute que
#     sur la boucle locale et le téléphone ne voit rien.
EXPO_PUBLIC_API_URL=http://localhost:3333/api/v1
