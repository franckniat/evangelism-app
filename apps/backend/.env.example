# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Base de données — PostgreSQL
#--------------------------------------------------------------------
# Chaîne de connexion complète, fournie par l'hébergeur (Neon, Supabase,
# Railway…). Elle CONTIENT UN MOT DE PASSE : ce fichier-ci est un modèle,
# la vraie valeur va dans `.env`, qui n'est jamais versionné.
#
#   DATABASE_URL=postgresql://<utilisateur>:<mot de passe>@<hôte>/<base>?sslmode=require
DATABASE_URL=

# Vérification du certificat TLS. Laisser à `true` : les hébergeurs gérés
# présentent un certificat valide. Ne passer à `false` que face à un serveur
# local en certificat auto-signé — jamais contre une base hébergée.
DB_SSL=true

# Taille maximale du pool. Les offres gratuites plafonnent sévèrement le
# nombre de connexions simultanées, d'où une valeur basse par défaut.
DB_POOL_MAX=5

#--------------------------------------------------------------------
# Limitation de débit
#--------------------------------------------------------------------
# `database` s'appuie sur PostgreSQL : durable, partagé entre instances,
# aucun service supplémentaire à faire tourner. `memory` est réservé aux
# tests. Basculer vers Redis plus tard ne demandera qu'un changement ici.
LIMITER_STORE=database

# Les limites par adresse IP sont désactivées pendant les tests : tous les
# tests sortent de la même adresse, ce qui rendrait l'ordre d'exécution
# significatif. Le comptage des échecs de connexion par compte, lui, reste
# actif — c'est celui qui protège réellement.
RATE_LIMIT_ENABLED=true

#--------------------------------------------------------------------
# File de travaux
#--------------------------------------------------------------------
# Rappels, mails, exports et suggestions de l'assistant passent par une
# file adossée à PostgreSQL (pg-boss), qui gère ses propres tables dans
# un schéma « pgboss » séparé. Mettre à `false` désactive les workers —
# utile pour un processus qui ne doit pas consommer de travaux.
QUEUE_ENABLED=true

#--------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------
# Origines autorisées en production, séparées par des virgules. Laisser
# vide interdit tout accès navigateur cross-origin — c'est volontaire :
# mieux vaut une intégration qui échoue bruyamment qu'une API ouverte.
# En développement, toutes les origines sont acceptées sans cette variable.
# CORS_ORIGIN=https://harvest.example,https://app.harvest.example

#--------------------------------------------------------------------
# ⚠️  Base de test — piège à connaître
#--------------------------------------------------------------------
# Les tests lisent `.env`, puis `.env.test` par-dessus. Sans `DATABASE_URL`
# dans `.env.test`, ils tournent SUR LA BASE DE DÉVELOPPEMENT — et les
# utilitaires de test d'AdonisJS la remettent à zéro.
#
# Avant d'écrire le premier test, créer `.env.test` avec une base séparée :
# une branche dédiée chez l'hébergeur, ou un second projet.
#
#   SESSION_DRIVER=memory
#   DATABASE_URL=postgresql://<utilisateur>:<mot de passe>@<hôte>/<base_test>?sslmode=require

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000